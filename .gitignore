# =============================================================================
# Heavy Biological Data (Raw & Intermediate Cache)
# =============================================================================
# Ignore all fasta, gbk, and tsv files in raw data except our small target gene
data/raw/*.fasta
data/raw/*.gbk
data/raw/*.fna
data/raw/*.fa
!data/raw/blaCTX-M-15_ref.fasta

# Ignore all intermediate processed cache
data/processed/

